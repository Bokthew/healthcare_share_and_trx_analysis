/* ---------------------------------------------------------------------
   STEP 19 : FLOW H : HEALTHCARE FACILITIES -> MEDICAL-DEVICE (ALKES) COMPANIES
   Purpose : All transactions between healthcare facilities and medical-device companies.
   Source  : whmart_union_compre_lite_aug_fix (Step 11), da_wholesale_nama_universe_faskes_clean (Step 10), Step 9 result
   Result  : edl_sandbox.da_wholesale_alkes_clean_update, da_wholesale_trx_outgoing_faskes_alkes_only
   --------------------------------------------------------------------- */

-- Universe of medical-device (alkes) company names in Indonesia
-- drop table edl_sandbox.da_wholesale_alkes_clean_update
CREATE TABLE edl_sandbox.da_wholesale_alkes_clean_update
STORED AS PARQUET
AS
WITH base_alkes AS(
    SELECT
        pendaftar AS nama_alkes,
        UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(pendaftar,'[^a-zA-Z0-9 ]',''),
                        '(^| )(PT|CV|TBK|LTD)( |$)',''),
                                '\\s+',' ')))
            AS nama_alkes_clean,
        alamat_pendaftar AS alamat_alkes,
        batch_date
    FROM edl_external.infoalkes_kemkes_rekapitulasi_izin_edar_alkes_dalam_negeri
),

-- Names of all medical-device companies in Indonesia
base_kemkes AS (
  SELECT DISTINCT
    ba.nama_alkes,
    ba.nama_alkes_clean,
    d.nocif AS nocif_alkes
  FROM base_alkes ba
  LEFT JOIN (SELECT DISTINCT nocif, namacif FROM edl_datamart.master_dpk_bsi WHERE batch_date='2026-07-26') d
  ON ba.nama_alkes_clean = UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(d.namacif,'[^a-zA-Z0-9 ]',''),
                              '(^| )(PT|CV|TBK|LTD)( |$)',''),
                                  '\\s+',' ')))
)

-- Union of the nationwide alkes list and the BSI-customer alkes companies

SELECT *
FROM (
  SELECT *,
    ROW_NUMBER () OVER (
      PARTITION BY nama_alkes
      ORDER BY
        CASE WHEN nocif_alkes IS NOT NULL THEN 1
        ELSE 2
      END) AS rn
  FROM (
      SELECT
      nama_alkes,
      nama_alkes_clean,
      nocif_alkes
    FROM base_kemkes
    UNION
    SELECT
      nama_alkes,
      nama_alkes_clean,
      nocif_dpk AS nocif_alkes
    FROM edl_sandbox.hasil_similarity_alkes
  ) a
) b
WHERE rn=1;


-- All transactions from healthcare facilities to medical-device companies
-- First, clean the principal and counterparty names
-- drop table edl_sandbox.da_wholesale_trx_outgoing_faskes_alkes_only
CREATE TABLE edl_sandbox.da_wholesale_trx_outgoing_faskes_alkes_only
STORED AS PARQUET
AS
WITH union_compre_lite_clean AS(
  SELECT *,
      UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(nama_rekanan,'[^a-zA-Z0-9 ]',' '),
        '(^| )(PT|CV|TBK|LTD)( |$)',' '),
            '\\s+',' ')))
      AS nama_rekanan_clean,
      UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(nama_principal,'[^a-zA-Z0-9 ]',' '),
        '(^| )(PT|CV|TBK|LTD)( |$)',' '),
            '\\s+',' ')))
      AS nama_principal_clean
  FROM edl_sandbox.whmart_union_compre_lite_aug_fix
),

-- Tag whether the principal is a facility or a medical-device company
tmp_principal_tag AS (
 SELECT DISTINCT
  a.nama_principal,
  fc.nama_faskes_clean AS faskes_principal,
  ac.nama_alkes_clean AS alkes_principal
 FROM union_compre_lite_clean a
 LEFT JOIN edl_sandbox.da_wholesale_nama_universe_faskes_clean fc
        ON a.nama_principal_clean = fc.nama_faskes_clean
  LEFT JOIN edl_sandbox.da_wholesale_alkes_clean_update ac
        ON a.nama_principal_clean = ac.nama_alkes_clean

  UNION

 SELECT DISTINCT
  a.nama_principal,
  fc.nama_faskes_clean AS faskes_principal,
  ac.nama_alkes_clean AS alkes_principal
 FROM union_compre_lite_clean a
 LEFT JOIN edl_sandbox.da_wholesale_nama_universe_faskes_clean fc
        ON a.nocif_principal = fc.nocif_faskes
  LEFT JOIN edl_sandbox.da_wholesale_alkes_clean_update ac
        ON a.nocif_principal = ac.nocif_alkes
),

-- Tag whether the counterparty is a facility or a medical-device company
tmp_rekanan_tag AS (
 SELECT DISTINCT
  a.nama_rekanan,
  fc.nama_faskes_clean AS faskes_rekanan,
  ac.nama_alkes_clean AS alkes_rekanan
 FROM union_compre_lite_clean a
 LEFT JOIN edl_sandbox.da_wholesale_nama_universe_faskes_clean fc
        ON a.nama_rekanan_clean = fc.nama_faskes_clean
  LEFT JOIN edl_sandbox.da_wholesale_alkes_clean_update ac
        ON a.nama_rekanan_clean = ac.nama_alkes_clean

  UNION

 SELECT DISTINCT
  a.nama_rekanan,
  fc.nama_faskes_clean AS faskes_rekanan,
  ac.nama_alkes_clean AS alkes_rekanan
 FROM union_compre_lite_clean a
 LEFT JOIN edl_sandbox.da_wholesale_nama_universe_faskes_clean fc
        ON a.nocif_rekanan = fc.nocif_faskes
  LEFT JOIN edl_sandbox.da_wholesale_alkes_clean_update ac
        ON a.nocif_rekanan = ac.nocif_alkes
),

-- All facility-to-alkes transactions, covering both the principal and the counterparty cases
tmp_trx AS (
 SELECT a.*,
  pf.faskes_principal,
  pf.alkes_principal,
  rf.faskes_rekanan,
  rf.alkes_rekanan
 FROM edl_sandbox.whmart_union_compre_lite_aug_fix a
 LEFT JOIN tmp_principal_tag pf
    ON pf.nama_principal = a.nama_principal
 LEFT JOIN tmp_rekanan_tag rf
    ON rf.nama_rekanan = a.nama_rekanan
  WHERE (pf.faskes_principal IS NOT NULL AND rf.alkes_rekanan IS NOT NULL AND debit_vol IS NOT NULL)
    OR (pf.alkes_principal IS NOT NULL AND rf.faskes_rekanan IS NOT NULL AND credit_vol IS NOT NULL)
)

SELECT *
FROM tmp_trx;

