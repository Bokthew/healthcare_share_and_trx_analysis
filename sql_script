/* ---------------------------------------------------------------------
   STEP 3 : COMMUNITY HEALTH CENTERS (PUSKESMAS) THAT ARE BSI CUSTOMERS
   Purpose : Match BSI customers against the updated puskesmas register (similarity score > 0.9), then add the matches found manually.
   Source  : edl_datamart.master_dpk_bsi (2026-08-30), whmart_list_puskesmas_update, whmart_puskesmas_bok_aceh
   Result  : edl_sandbox.whmart_master_dpk_clean, edl_sandbox.whmart_list_puskesmas_update_clean,
             edl_sandbox.hasil_similarity_puskemas_only_update   (the table name keeps the original spelling)
   --------------------------------------------------------------------- */

-- Cleaned customer names from the deposit (DPK) master, specific to community health centers (puskesmas)
-- drop table edl_sandbox.whmart_master_dpk_clean
CREATE TABLE edl_sandbox.whmart_master_dpk_clean
STORED AS PARQUET
AS
SELECT DISTINCT
    nocif,
    namacif,
        TRIM(UPPER(REGEXP_REPLACE(REGEXP_REPLACE(namacif,'[^a-zA-Z ]',''),
      '(AHMAD HADIWIJAYA QQ PUSKESMAS|TIM DOTS  PUSKESMAS|BINROH AR RIDHA PUSKESMAS|LAB TBC UPTD PUSKESMAS|BENDAHARA PUSKESMAS|BLU PUSKESMAS|BLU UPT PUSKESMAS|BLUD PUSKESMAS|BLUD BPG PUSKESMAS|BOK PUSKESMAS|DANA SOSIAL PUSKESMAS|DPK PPNI PUSKESMAS|FKTP PUSKESMAS|IBI RANTING PUSKESMAS|JAMPERSAL PUSKESMAS|JKN PUSKESMAS|KEP PUSKESMAS|KLUB PROLANIS UPT PUSKESMAS|LAB PROG TB PUSKESMAS|LAB TBC UPTD PUSKESMAS|LAB TCM PUSKESMAS|LAB UPT PUSKESMAS|LAB UPTD PUSKESMAS|LABOR PUSKESMAS|LABORATORIUM PUSKESMAS|MARIYONO PUSKESMAS|PENANGANAN TKIB PUSKESMAS|PMT LOKAL UPTD PUSKESMAS|PPNI DPK UPTD PUSKESMAS|PROGRAM TB PUSKESMAS|PROLANIS PUSKESMAS|PROLANIS UPT PUSKESMAS|PROLANIS UPTD PUSKESMAS|PUJI LESTARI PUSKESMAS|PROLANSI PUSKESMAS|REK BAYAR UPTD PUSKESMAS|RETRIBUSI UPTD PUSKESMAS|TIM DOTS PUSKESMAS|UPT PUSKESMAS|UPTD PUSKESMAS|UPZ PUSKESMAS|RUANGAN KIA PUSKESMAS|SEHAT BERSAMA PUSKESMAS|SENAM SEGAR PUSKESMAS|TBC UPTD PUSKESMAS|TCM PUSKESMAS|TIM IPWL PUSKESMAS|PUSAT KESEHATAN MASYARAKAT|BOK PUKESMAS|JKN PUKESMAS|PPNI PUSKESMAS|PUSAT KESEHATAN MASYARKAT|BOKPUKESMAS|BOK PKM|BOKPKM|DANA KAPITASI JKN FKTP|DANA JKN FKTP|JKN FKTP|PUSKESMAS PERAWATAN|PUSKESMAS KOTA|LABORATORIUM PUKESMAS)',
      'PUSKESMAS'
        )))
      AS namacif_clean,
    segmenbsi,
    kodebu,
    batch_date
FROM edl_datamart.master_dpk_bsi
WHERE batch_date = '2026-08-30'
  AND individu='C'
  AND namacif NOT IN ('PUSAT KESEHATAN INTEGRATIF','AKSELERASI PUSKESMAS INDONESIA','NURHAFIZAH   PUSKESMAS SN','PROMOTIF DAN PREVENTIF PUSKESMAS','PROMOTIF PREVENTIF PUSKESMAS','KSM PUSKESMAS');

-- Cleaned names from the updated puskesmas register (adds the word PUSKESMAS where missing)
-- drop table edl_sandbox.whmart_list_puskesmas_update_clean
CREATE TABLE edl_sandbox.whmart_list_puskesmas_update_clean
STORED AS PARQUET
AS
SELECT
    kode,
    nama_puskesmas,
      CASE WHEN nama_puskesmas LIKE '%PUSKESMAS%' THEN TRIM(UPPER(nama_puskesmas))
            ELSE TRIM(UPPER(CONCAT('PUSKESMAS ', nama_puskesmas)))
            END AS nama_puskesmas_clean,
    alamat,
    kecamatan,
    kabupaten,
    provinsi,
    kemampuan_pelayanan,
    karakteristik_wilayah_kerja
FROM edl_sandbox.whmart_list_puskesmas_update
-- where nama_puskesmas like '%PUSKESMAS%'
;


-- Puskesmas that are BSI customers (similarity score > 0.9)
-- drop table edl_sandbox.hasil_similarity_puskesmas_only_update
CREATE TABLE edl_sandbox.hasil_similarity_puskemas_only_update
STORED AS PARQUET
AS
WITH base AS (
    SELECT
        puc.kode,
        puc.nama_puskesmas AS nama_puskesmas_raw,
        puc.nama_puskesmas_clean,
        UPPER(puc.kabupaten) kabupaten,
        UPPER(puc.provinsi) provinsi,
        UPPER(puc.kemampuan_pelayanan) kemampuan_pelayanan,
        d.namacif AS namacif_dpk_raw,
        d.namacif_clean AS namacif_dpk,
        d.nocif AS nocif_dpk,
        d.segmenbsi AS segmenbsi_dpk,
        ROUND(1 - (
            CAST(
                LEVENSHTEIN(
                    d.namacif_clean,
                    puc.nama_puskesmas_clean
                ) AS DOUBLE
            )
            /
            GREATEST(
                LENGTH(d.namacif_clean),
                LENGTH(puc.nama_puskesmas_clean),
                1
            )
        ),2) AS similarity_score

    FROM edl_sandbox.whmart_master_dpk_clean d
    JOIN edl_sandbox.whmart_list_puskesmas_update_clean puc
    ON ABS(LENGTH(d.namacif_clean) - LENGTH(puc.nama_puskesmas_clean)) <=15  -- only compare names whose lengths differ by 15 characters or less (keeps the number of pairs manageable)
    WHERE (
        1 - (
            CAST(
                LEVENSHTEIN(
                    d.namacif_clean,
                    puc.nama_puskesmas_clean
                ) AS DOUBLE
            )
            /
            GREATEST(
                LENGTH(d.namacif_clean),
                LENGTH(puc.nama_puskesmas_clean),
                1
            )
        ) > 0.9
    )
),

-- Customer numbers (nocif) excluded after cleansing because they are not the same entity
list_exc AS(
  SELECT nocif_dpk
  FROM base
  WHERE nocif_dpk IN (
      '63226291', '89673316', '75099516', '89675902', '89678443', '83423543', '89676016', '89671629',
      '64666166', '63226291', '75099516', '75099516', '61252991', '63226291', '64655658', '89678564',
      '63226291', '53938777'
  )
),

-- Exclude the customers in list_exc whose similarity score is below 1 (an exact match is always kept)
temp_hasil AS (
  SELECT b.*
  FROM base b
  LEFT JOIN list_exc le
    ON b.nocif_dpk = le.nocif_dpk
  WHERE NOT (
    le.nocif_dpk IS NOT NULL
    AND b.similarity_score <1)
),

-- Manually added matches: puskesmas whose names differ so much that the score is < 0.9,
-- but which are confirmed BSI customers whose nocif does not appear in the similarity result
list_added (kode, nocif) AS (
  VALUES
    ('1000121945','89672647'),
    ('1000121775','89671457')
),

-- Manually added list, with extra information
list_added_full AS (
  SELECT
    la.kode,
    lpu.nama_puskesmas AS nama_puskesmas_raw,
    CONCAT('PUSKESMAS ', lpu.nama_puskesmas) AS nama_puskesmas_clean,
    lpu.kabupaten,
    lpu.provinsi,
    lpu.kemampuan_pelayanan,
    d.namacif AS nama_dpk_raw,
    pba.nama_nasabah AS namacif_clean,
    d.nocif AS nocif_dpk,
    d.segmenbsi AS segmenbsi_dpk,
    1 AS similarity_score
  FROM list_added la
  LEFT JOIN edl_sandbox.whmart_list_puskesmas_update lpu
    ON la.kode = lpu.kode
  LEFT JOIN (SELECT DISTINCT nocif, namacif, segmenbsi FROM edl_datamart.master_dpk_bsi WHERE batch_date ='2026-08-30') d
    ON la.nocif = d.nocif
  LEFT JOIN edl_sandbox.whmart_puskesmas_bok_aceh pba
    ON d.nocif = pba.nocif
)

SELECT *
FROM temp_hasil
UNION
SELECT *
FROM list_added_full;


/* ---------------------------------------------------------------------
   STEP 4 : HOSPITALS THAT ARE BSI CUSTOMERS
   Purpose : Match BSI customers against the Ministry of Health hospital register (similarity score > 0.95).
   Source  : da_wholesale_dpk_clean_pt, edl_external.sirs_kemkes_hospital_summary
   Result  : edl_sandbox.sirs_kemkes_hospital_clean, edl_sandbox.hasil_similarity_rumahsakit
   --------------------------------------------------------------------- */

-- Cleaned hospital names from the Ministry of Health hospital register (SIRS Kemkes), with a hospital category.
-- NOTE: the filter  UPPER(nama) RLIKE 'AVICENNA'  below looks like a leftover from testing: it limits this
-- table to hospitals with AVICENNA in the name. Remove it to cover all hospitals.
-- drop table edl_sandbox.sirs_kemkes_hospital_clean
CREATE TABLE edl_sandbox.sirs_kemkes_hospital_clean
STORED AS PARQUET
AS
SELECT
  kode AS kode_rs,
  nama AS nama_rs,
  UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(UPPER(nama),'[^a-zA-Z0-9 ]',''),
              '\\s+',' '),
              '\\b(PT|CV|TBK|LTD)\\b',''),
              '(^| )(RS UMUM DAERAH|RS UMUM|RS IBU DAN ANAK|RS GIGI DAN MULUT|RS JIWA|RS ANGKATAN DARAT|RS ANGKATAN LAUT|RS ANGKATAN UDARA|RS BEDAH|RS DAERAH|RS GIGI MULUT|RS IBU ANAK|RS ISLAM|RS KHUSUS BEDAH|
                RS KHUSUS GIGI DAN MULUT|RS KHUSUS GINJAL|RS KHUSUS IBU DAN ANAK|RS KHUSUS MATA|RS GIGI DAN MULUT|RS IBU DAN ANAK|RS JANTUNG DAN PEMBULUH DARAH|RS JIWA DAERAH|RS KHUSUS DAERAH GIGI DAN MULUT|
                RS KHUSUS IBU ANAK|RS KHUSUS GIGI DAN MULUT|
                RSK BEDAH|RSPAD|RSKJKO|RSUDZA|RSUPN|RSIGM|RSKIA|RSPAU|RUMKITBAN|RUMKITAL|RSUD|RSUP|RSIA|RSAB|RSKO|RSPAL|RSGM|RSAU|RSPI|RSNU|RSPKU|RSJD|RSU|RSI|RSM|RSJ|RSB|RST|RSD|RSA|RS|BOKPKM|BOK PKM|)( |$)', ' '),
              '\\s+',' ')))
    AS nama_rs_clean,
  nama_prop AS prov,
  kab AS kabkota,
  pemilik,
  kelas,
  jenis_rs,
  direktur,
  CASE
      WHEN UPPER(pemilik)= 'ORGANISASI ISLAM' THEN 'EKOSISTEM ISLAM'
      WHEN UPPER(nama) RLIKE 'MUHAMMADIYAH|ISLAM|RSI ' THEN 'EKOSISTEM ISLAM'
      WHEN UPPER(pemilik) RLIKE 'PEMPROP|PEMKAB|PEMKOT' THEN 'PEMERINTAH DAERAH'
      WHEN UPPER(pemilik) RLIKE 'TNI |KEMKES|POLRI|KEMENTERIAN' THEN 'PEMERINTAH PUSAT'
      WHEN UPPER(pemilik) RLIKE 'SWASTA|PERUSAHAAN|PERORANGAN|BUMN' THEN 'SWASTA & BUMN'
      WHEN UPPER(pemilik) RLIKE 'HINDU|BUDHA|KATHOLIK|PROTESTAN|SOSIAL' THEN 'ORGANISASI SOSIAL/KEAGAMAAN LAINNYA'
    END AS kategori_rs
FROM edl_external.sirs_kemkes_hospital_summary
WHERE UPPER(nama) RLIKE 'AVICENNA';


-- Hospitals that are BSI customers (similarity score > 0.95, stricter than the other steps)
-- drop table edl_sandbox.hasil_similarity_rumahsakit
CREATE TABLE edl_sandbox.hasil_similarity_rumahsakit
STORED AS PARQUET
AS
WITH base AS (
  SELECT
      s.kode_rs,
      s.nama_rs AS nama_rs_raw,
      s.nama_rs_clean AS nama_rs_clean,
      s.kategori_rs AS kategori_rs,
      d.namacif AS namacif_dpk_raw,
      d.namacif_clean AS namacif_dpk,
      d.nocif AS nocif_dpk,
      d.segmenbsi AS segmenbsi_dpk,

      ROUND(1 - (
          CAST(
              LEVENSHTEIN(
                  d.namacif_clean,
                  s.nama_rs_clean
              ) AS DOUBLE
          )
          /
          GREATEST(
              LENGTH(d.namacif_clean),
              LENGTH(s.nama_rs_clean),
              1
          )
      ),2) AS similarity_score

  FROM edl_sandbox.da_wholesale_dpk_clean_pt AS d
  JOIN edl_sandbox.sirs_kemkes_hospital_clean AS s
  ON ABS(LENGTH(d.namacif_clean) - LENGTH(s.nama_rs_clean)) <=15  -- only compare names whose lengths differ by 15 characters or less (keeps the number of pairs manageable)
  WHERE (
      1 - (
          CAST(
              LEVENSHTEIN(
                  d.namacif_clean,
                  s.nama_rs_clean
              ) AS DOUBLE
          )
          /
          GREATEST(
              LENGTH(d.namacif_clean),
              LENGTH(s.nama_rs_clean),
              1
          )
      ) > 0.95
  )
),

-- Customer names excluded after cleansing (generic names that match many hospitals by mistake)
list_exc AS (
  SELECT *
  FROM base
  WHERE namacif_dpk_raw IN (
      'ACEH', 'ADI GUNA CV', 'AISYIYAH', 'AL  HASANAH', 'AL CHASANAH', 'AL FATAH', 'AL HASANAH', 'AL HUDA',
      'AL ISLAM', 'ALIYAH', 'AMAL SEHAT', 'AMALIA MEDIKA', 'AMANAH', 'AMANAH CV', 'AMANAT', 'AMANDA',
      'AMANNA', 'AMINAH', 'AN NIMAH', 'ANANDA CV', 'ANDHIKA CV'
  )
),

-- Final result with an exclusion flag
all_result_sim AS (
  SELECT DISTINCT
    b.*,
    CASE WHEN e.namacif_dpk_raw IS NOT NULL THEN 1 ELSE 0 END AS flag_exc
  FROM base b
  LEFT JOIN list_exc e
    ON e.namacif_dpk_raw = b.namacif_dpk_raw
  ORDER BY b.similarity_score DESC, b.nama_rs_raw
)

-- Clean similarity result for hospitals (rejected matches removed)
SELECT *
FROM all_result_sim
WHERE flag_exc = 0;

