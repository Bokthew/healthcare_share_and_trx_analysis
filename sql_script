-- BSI SHARE OF HEALTHCARE-WORKER PAYROLL (FACILITY VIEW)
-- List of all payroll-customer facilities (hospital segment)
CREATE TABLE edl_sandbox.hasil_similarity_payroll_pov_faskes
STORED AS PARQUET
AS
WITH base_payroll AS (
  SELECT
    instansifinal AS instansi_raw,
    UPPER(TRIM(instansifinal)) AS instansi_upper
  FROM edl_datamart.master_payroll_phr_kolaborasi
  WHERE batch_date = '2026-06-30'
    AND categorysegmen = 'RS'
),

-- Payroll customers whose name is exactly the same as a customer name in the deposit master
-- (reduces the number of names that need similarity matching)
cek AS(
  SELECT
    d.nocif AS nocif,
    d.segmenbsi AS segmenbsi_dpk,
    UPPER(d.namacif) AS namacif_dpk,
    bp.instansi_upper AS instansi_raw
  FROM base_payroll bp
  LEFT JOIN (SELECT DISTINCT nocif, namacif, segmenbsi FROM edl_datamart.master_dpk_bsi WHERE batch_date='2026-08-04' AND individu='C') d
  ON bp.instansi_upper = d.namacif
),

-- ===== RESULT 1: payroll customers matched by exact name =====
hasil_nama_persis AS(
  SELECT DISTINCT
    c.instansi_raw,
    UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(TRIM(c.instansi_raw),'[^a-zA-Z0-9 ]',''),
                    '(^| )(PT|CV|TBK|LTD)( |$)',''),
                        '\\s+',' '))) AS instansi_clean,
    c.nocif AS nocif_dpk,
    c.namacif_dpk AS namacif_dpk,
    UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(TRIM(c.namacif_dpk),'[^a-zA-Z0-9 ]',''),
                    '(^| )(PT|CV|TBK|LTD)( |$)',''),
                        '\\s+',' '))) AS namacif_clean_dpk,
    c.segmenbsi_dpk,
    1 AS similarity_score,
    0 AS flag_exc
  FROM cek c
  WHERE c.nocif IS NOT NULL
),

-- Clean the facility names that were NOT found in the deposit master, so that similarity matching can be run on them
temp_payroll_undef AS (
  SELECT DISTINCT
    instansi_raw,
    TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(UPPER(TRIM(instansi_raw)), '[^a-zA-Z0-9 ]', ''),
          '(^| )(PT|CV|TBK|LTD|RUMAH SAKIT UMUM DAERAH|RUMAH SAKIT UMUM|RUMAH SAKIT IBU DAN ANAK|RUMAH SAKIT GIGI DAN MULUT|RUMAH SAKIT JIWA|RUMAH SAKIT ANGKATAN DARAT|RUMAH SAKIT ANGKATAN LAUT|RUMAH SAKIT ANGKATAN UDARA|RUMAH SAKIT BEDAH|RUMAH SAKIT DAERAH|RUMAH SAKIT KHUSUS BEDAH|RUMAH SAKIT KHUSUS GIGI DAN MULUT|RUMAH SAKIT KHUSUS GINJAL|RUMAH SAKIT KHUSUS IBU DAN ANAK|RUMAH SAKIT KHUSUS MATA|RUMAH SAKIT JANTUNG DAN PEMBULUH DARAH|RUMAH SAKIT JIWA DAERAH|RUMAH SAKIT KHUSUS DAERAH GIGI DAN MULUT|RUMAH SAKIT KHUSUS IBU ANAK|RUMAH SAKIT|RS UMUM DAERAH|RS UMUM|RS IBU DAN ANAK|RS GIGI DAN MULUT|RS JIWA|RS ANGKATAN DARAT|RS ANGKATAN LAUT|RS ANGKATAN UDARA|RS BEDAH|RS DAERAH|RS GIGI MULUT|RS IBU ANAK|RS ISLAM|RS KHUSUS BEDAH|RS KHUSUS GIGI DAN MULUT|RS KHUSUS GINJAL|RS KHUSUS IBU DAN ANAK|RS KHUSUS MATA|RS JANTUNG DAN PEMBULUH DARAH|RS JIWA DAERAH|RS KHUSUS DAERAH GIGI DAN MULUT|RS KHUSUS IBU ANAK|RSK BEDAH|RSPAD|RSKJKO|RSUDZA|RSUPN|RSIGM|RSKIA|RSPAU|RUMKITBAN|RUMKITAL|RSUD|RSUP|RSIA|RSAB|RSKO|RSPAL|RSGM|RSAU|RSPI|RSNU|RSPKU|RSJD|RSU|RSI|RSM|RSJ|RSB|RST|RSD|RSA|RS|BOKPKM|BOK PKM)( |$)', ' '), '\\s+', ' ')) AS instansi_clean
  FROM cek c
  WHERE c.nocif IS NULL
),

-- Clean the deposit-master names for comparison
base_dpk AS (
  SELECT
    nocif,
    namacif,
    UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(namacif, '[^a-zA-Z0-9 ]', ''), '(^| )(PT|CV|TBK|LTD)( |$)', ''), '\\s+', ' '))) AS namacif_clean,
    segmenbsi,
    kodebu,
    jenisproduk,
    batch_date
  FROM edl_datamart.master_dpk_bsi
  WHERE batch_date = '2026-07-26'
    AND individu = 'C'
),

-- Compute the similarity score to see which facilities are already BSI customers
hasil AS (
  SELECT
    p.instansi_raw,
    p.instansi_clean,
    d.nocif AS nocif_dpk,
    d.namacif AS namacif_dpk,
    d.namacif_clean AS namacif_clean_dpk,
    d.segmenbsi AS segmenbsi_dpk,
    ROUND(
      1 - (
        CAST(LEVENSHTEIN(d.namacif_clean, p.instansi_clean) AS DOUBLE)
        /
        GREATEST(LENGTH(d.namacif_clean), LENGTH(p.instansi_clean), 1)
      ), 2
    ) AS similarity_score
  FROM temp_payroll_undef p
  JOIN base_dpk d
    ON ABS(LENGTH(d.namacif_clean) - LENGTH(p.instansi_clean)) <= 15
    AND p.instansi_clean <> ''
  WHERE (
    1 - (
      CAST(LEVENSHTEIN(d.namacif_clean, p.instansi_clean) AS DOUBLE)
      /
      GREATEST(LENGTH(d.namacif_clean), LENGTH(p.instansi_clean), 1)
    )
  ) > 0.9
),

-- Customer numbers excluded after cleansing
list_exc AS(
  SELECT nocif_dpk
  FROM hasil
  WHERE nocif_dpk IN (
      '50064782', '50184635', '50286756', '50338729', '50470761', '50809160', '51565646', '51896553',
      '51941436', '52194634', '53003113', '53055082', '53897087', '53995674', '54351044', '54485177',
      '54515649', '60054269', '60275656', '60515127', '60573014', '60951212', '61012705', '61149121',
      '61298172', '61512614', '61522926', '61661843', '61948809', '62365009', '62462160', '62725278',
      '62869272', '62888960', '63087381', '63113728'
  )
),

-- Final similarity result with an exclusion flag
all_hasil_sim AS (
  SELECT DISTINCT
    h.*,
    CASE WHEN e.nocif_dpk IS NOT NULL THEN 1 ELSE 0 END AS flag_exc
  FROM hasil h
  LEFT JOIN list_exc e
  ON h.nocif_dpk = e.nocif_dpk
),

-- ===== RESULT 2: similarity matches (to be combined with the exact-name matches) =====
hasil_similarity AS(
  SELECT DISTINCT *
  FROM all_hasil_sim
