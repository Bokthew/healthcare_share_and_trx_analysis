/* ===========================================================================================
   HEALTHCARE ECOSYSTEM ANALYSIS:
   - BSI SHARE (NAME-SIMILARITY MATCHING)
   - TRANSACTION FLOW ANALYSIS
   ===========================================================================================

   PURPOSE:
   Measure how much of the Indonesian healthcare ecosystem is already served by BSI, and where the
   money flows inside it.
     PART 1 finds which healthcare-related organisations (clinics, community health centers,
            hospitals, insurers, pharmacies, medical-device companies, payroll customers) are already
            BSI customers, by comparing their names with official registers (name similarity).
     PART 2 pulls the money flows between the parties of the ecosystem (public, BPJS Kesehatan,
            insurers, healthcare facilities, payroll, pharmaceutical wholesalers, medical devices).

   KEY TERMS
   - BSI          : the bank (Bank Syariah Indonesia)
   - DPK          : customer deposits (Dana Pihak Ketiga); "master_dpk_bsi" = master table of BSI deposit customers
   - CIF / nocif  : customer identification number at the bank
   - Faskes       : healthcare facility (clinic, community health center or hospital)
   - Puskesmas    : community health center run by the government
   - Klinik / RS  : clinic / hospital (Rumah Sakit)
   - BPJS Kesehatan : the national health insurance agency
   - PBF          : pharmaceutical wholesaler (Pedagang Besar Farmasi)
   - Alkes        : medical devices (alat kesehatan)
   - Nakes        : healthcare worker (tenaga kesehatan)
   - Masyarakat   : the general public (here: retail customers, individu = 'R')
   - Principal    : the customer being analysed
   - Rekanan      : counterparty (the other party in a transaction with the principal)
   - TFD          : Transaction Flow Diagram (TFD Compre = Corporate/Commercial, TFD Lite = other segments)
   - Similarity score : 1 - (Levenshtein distance / length of the longer name); 1 = identical names,
                        a score above 0.9 (hospitals: 0.95) is treated as "same organisation"
   - flag_exc     : 1 = a similarity match that was rejected after manual review (excluded from the result)

   OTHER INDONESIAN WORDS USED IN TABLE / COLUMN NAMES
   - nasabah = customer, instansi = institution, nama = name, norek / norekening = account number
   - pengirim / penerima = sender / receiver, rekening sumber / tujuan = source / destination account
   - pegawai = employee, asuransi = insurance, apotek = pharmacy, farmasi = pharmaceutical
   - emas = gold, kesehatan = health, kemkes / kemenkes = Ministry of Health, rumahsakit = hospital

   DATES USED (hard-coded in the queries; update them for a new run)
   - master_dpk_bsi snapshot          : 2026-07-26 (clinics, hospitals, insurers, pharmacies, medical devices)
                                        2026-08-30 (puskesmas)   2026-08-04 (payroll, facility view)
                                        2026-08-31 (all transaction steps, Part 2)
   - Ministry of Health clinic scrape : 2026-06-08 (batch date of the Data Management team)
   - Payroll data snapshot            : 2026-06-30 (Part 1)   |   2026-01-01 to 2026-08-31 (Part 2)
   - Transactions (DMX / TFD)         : 2026-01-01 to 2026-08-31

   LIST OF STEPS
   PART 1 - Which healthcare organisations are BSI customers? (name similarity)
     1.  Shared lookup: cleaned names of BSI corporate customers
     2.  Clinics
     3.  Community health centers (puskesmas)
     4.  Hospitals
     5.  Insurance companies
     6.  Payroll customers - facility view
     7.  Payroll customers - employee view (healthcare workers)
     8.  Pharmacies and pharmaceutical companies
     9.  Medical-device (alkes) companies
   PART 2 - Money flows inside the healthcare ecosystem
     10. Shared lookup: universe of healthcare-facility names
     11. Shared lookup: combined TFD table (Corporate/Commercial + other segments), Jan-Aug
     12. Flow A : public -> BPJS Kesehatan
     13. Flow B : public -> insurance companies
     14. Flow C : public -> healthcare facilities
     15. Flow D : BPJS Kesehatan -> healthcare facilities
     16. Flow E : insurance companies -> healthcare facilities
     17. Flow F : healthcare facilities -> payroll
     18. Flow G : healthcare facilities -> pharmaceutical wholesalers (PBF)
     19. Flow H : healthcare facilities -> medical-device (alkes) companies
     20. Summary of all outgoing facility transactions (PBF + alkes)
   =========================================================================================== */

/* ==============================================================================
   PART 1 - WHICH HEALTHCARE ORGANISATIONS ARE BSI CUSTOMERS? (NAME SIMILARITY)
   ============================================================================== */

/* ---------------------------------------------------------------------
   STEP 1 : SHARED LOOKUP - CLEANED NAMES OF BSI CORPORATE CUSTOMERS
   Purpose : Clean the customer names in the deposit master (remove legal-form words such as PT / CV / TBK / LTD
             and hospital prefixes such as RS, RSUD) so that they can be compared with official registers.
   Source  : edl_datamart.master_dpk_bsi (corporate customers only, individu = 'C')
   Result  : edl_sandbox.da_wholesale_dpk_clean_pt   (used by Steps 2, 4, 8 and 9)
   NOTE    : The line breaks inside the long name patterns (here and in Steps 2 and 4) are part of the original text. Pattern items
             that start right after a line break cannot match a name, so they have no effect. Kept as-is so results do not change.
   --------------------------------------------------------------------- */

-- Cleaned corporate-customer names from the BSI deposit (DPK) master, so that name variations can be matched
-- drop table edl_sandbox.da_wholesale_dpk_clean_pt
CREATE TABLE edl_sandbox.da_wholesale_dpk_clean_pt
STORED AS PARQUET
AS
SELECT
    nocif,
    namacif,
    UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(namacif,'[^a-zA-Z0-9 ]',''),
                            '\\s+',' '),
                            '\\b(PT|CV|TBK|LTD)\\b',''),
                            '(^| )(RS UMUM DAERAH|RS UMUM|RS IBU DAN ANAK|RS GIGI DAN MULUT|RS JIWA|RS ANGKATAN DARAT|RS ANGKATAN LAUT|RS ANGKATAN UDARA|RS BEDAH|RS DAERAH|RS GIGI MULUT|RS IBU ANAK|RS ISLAM|RS KHUSUS BEDAH|
                                RS KHUSUS GIGI DAN MULUT|RS KHUSUS GINJAL|RS KHUSUS IBU DAN ANAK|RS KHUSUS MATA|RS GIGI DAN MULUT|RS IBU DAN ANAK|RS JANTUNG DAN PEMBULUH DARAH|RS JIWA DAERAH|RS KHUSUS DAERAH GIGI DAN MULUT|
                                RS KHUSUS IBU ANAK|RS KHUSUS GIGI DAN MULUT|
                                RSK BEDAH|RSPAD|RSKJKO|RSUDZA|RSUPN|RSIGM|RSKIA|RSPAU|RUMKITBAN|RUMKITAL|RSUD|RSUP|RSIA|RSAB|RSKO|RSPAL|RSGM|RSAU|RSPI|RSNU|RSPKU|RSJD|RSU|RSI|RSM|RSJ|RSB|RST|RSD|RSA|RS|BOKPKM|BOK PKM|)( |$)', ' '),
                            '\\s+',' ')))
        AS namacif_clean,
    segmenbsi,
    kodebu,
    --jenisproduk,
    batch_date
FROM edl_datamart.master_dpk_bsi
WHERE batch_date = '2026-07-26' AND individu='C';


