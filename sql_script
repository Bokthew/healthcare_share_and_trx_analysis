-- Cleaned facility names from the Ministry of Health (Kemenkes / SatuSehat) register, so that name variations can be matched
-- drop table edl_sandbox.da_wholesale_satusehat_kemenkes_clean
CREATE TABLE edl_sandbox.da_wholesale_satusehat_kemenkes_clean
STORED AS PARQUET
AS
SELECT
    namefacility,
    UPPER(TRIM(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(namefacility,'[^a-zA-Z0-9 ]',''),
                        '\\s+',' '),
                        '\\b(PT|CV|TBK|LTD)\\b',''),
                        '(^| )(RS Umum Daerah|RS Umum|RS Ibu dan Anak|RS Gigi Dan Mulut|RS Jiwa|RS Angkatan Darat|RS Angkatan Laut|RS Angkatan Udara|RS Bedah|RS Daerah|RS Gigi Mulut|RS Ibu Anak|RS Islam|RS Khusus Bedah|
                            RS Khusus Gigi dan Mulut|RS Khusus Ginjal|RS Khusus Ibu dan Anak|RS Khusus Mata|RS Gigi dan Mulut|RS Ibu Dan Anak|RS Jantung dan Pembuluh Darah|RS Jiwa Daerah|RS Khusus Daerah Gigi dan Mulut|
                            RS Khusus Ibu Anak|RS Khusus Gigi dan Mulut|
                            RSK BEDAH|RSPAD|RSKJKO|RSUDZA|RSUPN|RSIGM|RSKIA|RSPAU|RUMKITBAN|RUMKITAL|RSUD|RSUP|RSIA|RSAB|RSKO|RSPAL|RSGM|RSAU|RSPI|RSNU|RSPKU|RSJD|RSU|RSI|RSM|RSJ|RSB|RST|RSD|RSA|RS|BOKPKM|BOK PKM|)( |$)', ' '),
                        '\\s+',' ')))
        AS namefacility_clean,
    districtdescription,
    phone,
    typefacility,
    batch_date,
    id
FROM edl_external.satusehat_kemkes_healthcare_facilities_fasyankes
WHERE batch_date = '2026-06-08'  -- scraping date of the Data Management (DM) team
AND typefacility IN ('["Klinik"]');
-- Other facility types available in the register (switch the filter above to use them):
-- and typefacility in ('["Rumah Sakit"]', '["Klinik"]', '["Pusat Kesehatan Masyarakat"]', '["Apotek"]', '["Laboratorium Kesehatan"]');


-- Clinics that are BSI customers: name similarity score > 0.9 between the deposit master and the Ministry of Health register
-- drop table edl_sandbox.hasil_similarity_klinik_puskemas
CREATE TABLE edl_sandbox.hasil_similarity_klinik_puskemas
STORED AS PARQUET
AS
WITH base AS (
    SELECT
        s.namefacility AS nama_fasyankes_raw,
        s.namefacility_clean AS nama_fasyankes,
        s.districtdescription AS lokasi,
        s.phone,
        s.id,
        REGEXP_REPLACE(s.typefacility, '[^a-zA-Z0-9 ]', '') AS jenis_faskes,
        d.namacif AS namacif_dpk_raw,
        d.namacif_clean AS namacif_dpk,
        d.nocif AS nocif_dpk,
        d.segmenbsi AS segmenbsi_dpk,

        ROUND(1 - (
            CAST(
                LEVENSHTEIN(
                    d.namacif_clean,
                    s.namefacility_clean
                ) AS DOUBLE
            )
            /
            GREATEST(
                LENGTH(d.namacif_clean),
                LENGTH(s.namefacility_clean),
                1
            )
        ),2) AS similarity_score

    FROM edl_sandbox.da_wholesale_dpk_clean_pt AS d
    JOIN edl_sandbox.da_wholesale_satusehat_kemenkes_clean AS s
    ON ABS(LENGTH(d.namacif_clean) - LENGTH(s.namefacility_clean)) <=15  -- only compare names whose lengths differ by 15 characters or less (keeps the number of pairs manageable)
    WHERE (
        1 - (
            CAST(
                LEVENSHTEIN(
                    d.namacif_clean,
                    s.namefacility_clean
                ) AS DOUBLE
            )
            /
            GREATEST(
                LENGTH(d.namacif_clean),
                LENGTH(s.namefacility_clean),
                1
            )
        ) > 0.9
    )
),

-- List of facility IDs excluded after manual cleansing (false matches)
list_exc AS (
  SELECT *
  FROM base
  WHERE id IN (
      '777', '1274', '1397', '1541', '1644', '1684', '1904', '2042',
      '2076', '2257', '2276', '2302', '2615', '2661', '2688', '2719'
  )
),

-- Final result with an exclusion flag (flag_exc = 1: the match was rejected after review)
all_result_sim AS (
  SELECT DISTINCT
    b.*,
    CASE WHEN e.id IS NOT NULL THEN 1 ELSE 0 END AS flag_exc
  FROM base b
  LEFT JOIN list_exc e
    ON b.id = e.id
  ORDER BY b.similarity_score DESC, b.nama_fasyankes_raw
)

-- Clean similarity result for clinics (rejected matches removed)
SELECT DISTINCT *
FROM all_result_sim
WHERE flag_exc = 0;

